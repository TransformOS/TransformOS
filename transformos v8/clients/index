<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Client Portal — TransformOS</title>
<meta name="robots" content="noindex,nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#0D1B2A; --navy2:#142236; --navy3:#1C2F45;
  --gold:#C9922A; --gold2:#E8B454; --gold3:#F5D48A;
  --cream:#F2EDE4; --mist:#B8C4D0; --slate:#6B7F92; --white:#fff;
  --border:rgba(201,146,42,.28); --bdim:rgba(184,196,208,.14);
  --serif:'Cormorant Garamond',Georgia,serif;
  --sans:'DM Sans',system-ui,sans-serif;
  --mono:'DM Mono',ui-monospace,monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--navy);color:var(--mist);font-family:var(--sans);font-weight:300;
  min-height:100vh;display:flex;flex-direction:column;-webkit-font-smoothing:antialiased}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:linear-gradient(rgba(201,146,42,.045) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(201,146,42,.045) 1px,transparent 1px);
  background-size:64px 64px}
.tname{color:var(--white)}.tos{color:var(--gold2)}

nav{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;
  padding:1.6rem 3rem;border-bottom:1px solid var(--bdim)}
.nav-logo{font-family:var(--serif);font-size:1.5rem;font-weight:600;letter-spacing:.02em;text-decoration:none}
.nav-back{font-family:var(--mono);font-size:.66rem;letter-spacing:.13em;text-transform:uppercase;
  color:var(--mist);text-decoration:none;transition:color .2s}
.nav-back:hover{color:var(--gold2)}

main{position:relative;z-index:2;flex:1;display:flex;align-items:center;justify-content:center;padding:3rem 2rem}
.box{width:100%;max-width:480px}
.eyebrow{font-family:var(--mono);font-size:.64rem;letter-spacing:.22em;text-transform:uppercase;
  color:var(--gold2);margin-bottom:1.4rem}
h1{font-family:var(--serif);font-size:clamp(2rem,4vw,2.9rem);font-weight:300;line-height:1.15;
  color:var(--white);margin-bottom:1.3rem}
h1 em{font-style:italic;color:var(--gold2)}
.intro{font-size:.95rem;line-height:1.8;margin-bottom:2.4rem}

.row{display:flex;gap:.6rem}
#code{flex:1;background:var(--navy2);border:1px solid var(--bdim);color:var(--cream);
  padding:.95rem 1.1rem;font-family:var(--mono);font-size:.9rem;letter-spacing:.12em;text-transform:uppercase}
#code::placeholder{color:var(--slate);letter-spacing:.1em}
#code:focus{outline:none;border-color:var(--gold)}
.btn{font-family:var(--mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;
  background:var(--gold2);color:var(--navy);border:none;padding:.95rem 1.9rem;cursor:pointer;font-weight:500;
  transition:background .2s}
.btn:hover{background:var(--gold3)}
.msg{font-size:.8rem;margin-top:1rem;min-height:1.3rem}
.msg.err{color:#E07A5F}
.msg.ok{color:#7FB069}

.note{margin-top:3rem;padding-top:1.8rem;border-top:1px solid var(--bdim);font-size:.82rem;
  color:var(--slate);line-height:1.75}
.note a{color:var(--gold2);text-decoration:none}
.note a:hover{color:var(--gold3)}

footer{position:relative;z-index:2;padding:1.6rem 3rem;border-top:1px solid var(--bdim);
  font-family:var(--mono);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--slate)}
@media(max-width:640px){nav,footer{padding-left:1.4rem;padding-right:1.4rem}.row{flex-direction:column}}
</style>
</head>
<body>

<nav>
  <a href="/" class="nav-logo"><span class="tname">Transform</span><span class="tos">OS</span></a>
  <a href="/" class="nav-back">← Back to site</a>
</nav>

<main>
  <div class="box">
    <div class="eyebrow">Client Portal</div>
    <h1>Your transformation, <em>live.</em></h1>
    <p class="intro">Enter the access code issued with your engagement to open your portal — the full analysis, the scenario modeller, and every stage of your transformation in one place.</p>

    <div class="row">
      <input id="code" placeholder="Access code" autocomplete="off" spellcheck="false"
             onkeydown="if(event.key==='Enter')go()">
      <button class="btn" onclick="go()">Enter</button>
    </div>
    <div class="msg" id="msg"></div>

    <div class="note">
      Don't have a code, or lost yours? <a href="mailto:transform@transformos.co.uk?subject=Client%20portal%20access">Email us</a> and we'll reissue it.<br>
      Looking for the main site instead? <a href="/">transformos.co.uk</a>
    </div>
  </div>
</main>

<footer><span class="tname">Transform</span><span class="tos">OS</span> &nbsp;·&nbsp; Confidential client access</footer>

<script>
/* ═══ CLIENT ROUTING — add a line per client ═══ */
const CLIENTS = {
  'BIF-2026': { path: '/clients/bif/', name: 'Business in Focus Limited' }
  // 'MENTERA-2026': { path: '/clients/mentera/', name: 'Mentera' },
};
/* ═════════════════════════════════════════════ */

function go(){
  const v = document.getElementById('code').value.trim().toUpperCase();
  const m = document.getElementById('msg');
  if(!v){ m.className='msg err'; m.textContent='Enter your access code.'; return; }
  const c = CLIENTS[v];
  if(c){
    m.className='msg ok';
    m.textContent='Opening ' + c.name + '…';
    sessionStorage.setItem('bif_ok','1');
    setTimeout(()=>{ window.location.href = c.path; }, 500);
  } else {
    m.className='msg err';
    m.textContent='Access code not recognised. Check the code issued with your engagement.';
  }
}
document.getElementById('code').focus();
</script>
</body>
</html>
